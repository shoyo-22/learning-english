# Server-only manual configuration. For ready local test settings, use npm run setup:demo or setup:local.
# Full instructions: docs/INSTALLATION.ru.md. Copy this template only for your own manual/cloud setup.
SUPABASE_URL=
# Supabase secret key (sb_secret_...) or legacy service_role JWT; not a publishable key.
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters. Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional canonical deployment origin.
APP_URL=
