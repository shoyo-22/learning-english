# Server-only configuration. Copy to .env.local and fill in locally.
SUPABASE_URL=
# Supabase secret key (sb_secret_...) or legacy service_role JWT; not a publishable key.
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters. Generate: openssl rand -hex 32
SESSION_SECRET=
# Optional canonical deployment origin.
APP_URL=
