{
  "name": "english-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src tests supabase scripts docs README.md QA.md *.json *.mjs next.config.ts",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-supabase.mjs",
    "setup:demo": "node scripts/local-setup.mjs demo",
    "setup:local": "node scripts/local-setup.mjs local",
    "db:local:start": "node scripts/local-setup.mjs start",
    "db:local:stop": "node scripts/local-setup.mjs stop",
    "dev:local": "next dev --hostname localhost",
    "start:local": "next start --hostname localhost"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@supabase/supabase-js": "latest",
    "@tailwindcss/postcss": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "latest",
    "next": "latest",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "server-only": "latest",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "latest",
    "tw-animate-css": "^1.4.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prettier": "^3.9.6",
    "supabase": "2.116.0",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
